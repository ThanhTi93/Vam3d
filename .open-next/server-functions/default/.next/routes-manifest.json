{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/movie/[id]",
      "regex": "^/movie/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/movie/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/movie/[id].segments/movie/$d$id$segment",
          "source": "^/movie/(?<nxtPid>[^/]+?)\\.segments/movie/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    },
    {
      "page": "/[categoryName]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategoryName": "nxtPcategoryName"
      },
      "namedRegex": "^/(?<nxtPcategoryName>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/[categoryName].segments/$d$categoryName$segment",
          "source": "^/(?<nxtPcategoryName>[^/]+?)\\.segments/\\$d\\$categoryName(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPcategoryName": "nxtPcategoryName"
          }
        }
      ]
    }
  ],
