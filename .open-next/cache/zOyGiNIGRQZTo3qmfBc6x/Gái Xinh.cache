ện Thành Thần là bộ truyện huyền huyễn của tác giả Ân Tứ Giải Thoát, kể về hành trình tu luyện của La Chinh—một thiếu gia từng có địa vị cao nhưng sau biến cố gia tộc lại bị đẩy xuống làm nô bộc.\\\",\\\"videoUrl\\\":\\\"\\\",\\\"views\\\":0,\\\"isHot\\\":false,\\\"episodes\\\":[]},{\\\"id\\\":\\\"26\\\",\\\"title\\\":\\\"Phàm Nhân Tu Tiên\\\",\\\"originalTitle\\\":\\\"\\\",\\\"thumbnail\\\":\\\"https://vam3d.b-cdn.net/movies/Pham_Nhan_Tu_Tien_ugzfai.webp\\\",\\\"banner\\\":\\\"https://vam3d.b-cdn.net/movies/Pham_Nhan_Tu_Tien_ugzfai.webp\\\",\\\"category\\\":\\\"phim-le\\\",\\\"genres\\\":[\\\"HH Trung Quốc\\\"],\\\"rating\\\":0,\\\"votes\\\":0,\\\"year\\\":2026,\\\"duration\\\":\\\"—\\\",\\\"quality\\\":\\\"HD\\\",\\\"sub\\\":\\\"Vietsub\\\",\\\"director\\\":\\\"Vam 3D\\\",\\\"cast\\\":[],\\\"description\\\":\\\"Phàm Nhân Tu Tiên là bộ tiểu thuyết tiên hiệp nổi tiếng của tác giả Vong Ngữ, kể về hành trình tu luyện của Hàn Lập – một thiếu niên nông thôn bình thường, tư chất không nổi bật nhưng có ý chí kiên trì, đầu óc tỉnh táo và tính cách vô cùng thận trọng.\\\",\\\"videoUrl\\\":\\\"\\\",\\\"views\\\":0,\\\"isHot\\\":false,\\\"episodes\\\":[]},{\\\"id\\\":\\\"25\\\",\\\"title\\\":\\\"Đấu Phá Thương Khung\\\",\\\"originalTitle\\\":\\\"\\\",\\\"thumbnail\\\":\\\"https://cdn.vam3dhentai.online/movies/Dau_Pha_Thuong_Khung_bbkmxp.webp\\\",\\\"banner\\\":\\\"https://cdn.vam3dhentai.online/movies/Dau_Pha_Thuong_Khung_bbkmxp.webp\\\",\\\"category\\\":\\\"phim-le\\\",\\\"genres\\\":[\\\"HH Trung Quốc\\\",\\\"Sex AI\\\",\\\" Hentai 3D\\\",\\\"Sex 3D\\\",\\\"AI\\\",\\\"Ảnh Sex\\\",\\\"Ảnh 3D\\\",\\\"Ảnh Sex 3D\\\",\\\"Vú bự\\\",\\\"Ảnh Sex AI\\\",\\\"China Animation\\\",\\\"Sexy\\\",\\\"Gái Xinh\\\",\\\"Girl Xinh\\\",\\\"Hoạt Hình 3D\\\",\\\"Hoạt Hình 3D Trung Quốc\\\"],\\\"rating\\\":0,\\\"votes\\\":0,\\\"year\\\":2026,\\\"duration\\\":\\\"—\\\",\\\"quality\\\":\\\"HD\\\",\\\"sub\\\":\\\"Vietsub\\\",\\\"director\\\":\\\"Vam 3D\\\",\\\"cast\\\":[],\\\"description\\\":\\\"Đấu